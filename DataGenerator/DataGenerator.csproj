<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>TradingDataGenerator</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Versions are a safe baseline; run `dotnet add package <name>` to pick up the latest. -->
    <PackageReference Include="Bogus" Version="35.6.5" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <!-- Pinned: SqlClient 7.1.1 pulls in 9.0.18, which has known vulnerabilities. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="XTests" />
  </ItemGroup>

</Project>
