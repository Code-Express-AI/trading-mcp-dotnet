# Copy this file to .env (which is git-ignored) and change both passwords and the token.
#
# SQL Server requires 8+ characters with at least 3 of: uppercase, lowercase, digit, symbol.
# If the password is too weak, SQL Server won't start. Check with: docker compose logs sqlserver
# Avoid these characters: ' " | & \ $ ! (they can break Compose interpolation or the init script).

SA_PASSWORD=Sa-ChangeMe-2026x
MCP_READER_PASSWORD=Reader-ChangeMe-2026x

# The bearer token MCP clients send to the local server (Authorization: Bearer <token>). Change it too:
# any random value of 32 or more characters.
MCP_TOKEN=Token-ChangeMe-2026x-at-least-32-characters
